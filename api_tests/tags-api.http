# Get all tags
GET http://localhost:5000/api/tags
Accept: application/json
###

# Create a new tag
POST http://localhost:5000/api/tags
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "tag_name": "New Tag" }
###

# Update a tag
PUT http://localhost:5000/api/tags/32
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "tag_name": "Dragon Ball Z" }

###

# Link a Tag to a Project
POST http://localhost:5000/api/tags/link
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ 
    "project_id": 4,
    "tag_id": 1,
    "is_primary": true
}
###

# Delete an existing tag
DELETE http://localhost:5000/api/tags/23
Authorization: Bearer {{accessToken}}